#!/usr/bin/env bash

set -euo pipefail

CONFIG_ROOT="${XDG_CONFIG_HOME:-${HOME:?HOME must be set}/.config}/codex-github-machine"
CONFIG_FILE="$CONFIG_ROOT/setup.env"

if [[ ! -r "$CONFIG_FILE" ]]; then
  printf 'agent-git: missing configuration: %s\n' "$CONFIG_FILE" >&2
  printf 'Run scripts/setup-github-machine-user.sh first.\n' >&2
  exit 1
fi

# shellcheck disable=SC1090
source "$CONFIG_FILE"

: "${AGENT_GITHUB_USER:?missing AGENT_GITHUB_USER in $CONFIG_FILE}"
: "${AGENT_GITHUB_EMAIL:?missing AGENT_GITHUB_EMAIL in $CONFIG_FILE}"
: "${AGENT_GITHUB_AUTH_KEY:?missing AGENT_GITHUB_AUTH_KEY in $CONFIG_FILE}"
: "${AGENT_GITHUB_SIGNING_KEY:?missing AGENT_GITHUB_SIGNING_KEY in $CONFIG_FILE}"

LEGACY_TARGET_REPO=${TARGET_REPO:-}
REPOSITORIES_FILE=${AGENT_GITHUB_REPOSITORIES_FILE:-$CONFIG_ROOT/repositories}
unset TARGET_REPO

for dependency in git ssh; do
  if ! command -v "$dependency" >/dev/null 2>&1; then
    printf 'agent-git: required command not found: %s\n' "$dependency" >&2
    exit 1
  fi
done

if [[ ! -r "$AGENT_GITHUB_AUTH_KEY" || ! -r "$AGENT_GITHUB_SIGNING_KEY" ]]; then
  printf 'agent-git: configured SSH key is missing or unreadable\n' >&2
  exit 1
fi

canonical_repository() {
  local remote_url=$1 repository

  case "$remote_url" in
    https://github.com/*)
      repository=${remote_url#https://github.com/}
      ;;
    git@github.com:*)
      repository=${remote_url#git@github.com:}
      ;;
    ssh://git@github.com/*)
      repository=${remote_url#ssh://git@github.com/}
      ;;
    *)
      return 1
      ;;
  esac

  repository=${repository%.git}
  repository=${repository%/}
  [[ "$repository" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || return 1
  printf '%s\n' "$repository"
}

current_repository() {
  local remote_url repository

  remote_url=$(git remote get-url origin 2>/dev/null || true)
  repository=$(canonical_repository "$remote_url" 2>/dev/null || true)
  if [[ -z "$repository" ]]; then
    printf 'agent-git: cannot identify a GitHub origin for the current checkout\n' >&2
    exit 1
  fi
  printf '%s\n' "$repository"
}

require_registered_repository() {
  local repository=$1

  if [[ -r "$REPOSITORIES_FILE" ]] && grep -Fqx -- "$repository" "$REPOSITORIES_FILE"; then
    return 0
  fi
  if [[ ! -e "$REPOSITORIES_FILE" && -n "$LEGACY_TARGET_REPO" && \
        "$repository" == "$LEGACY_TARGET_REPO" ]]; then
    return 0
  fi

  printf 'agent-git: repository is not registered for @%s: %s\n' \
    "$AGENT_GITHUB_USER" "$repository" >&2
  printf 'Ask the repository owner to grant @%s write access and have the invitation accepted.\n' \
    "$AGENT_GITHUB_USER" >&2
  printf 'After access is active, run: agent-gh register %s\n' "$repository" >&2
  exit 1
}

TARGET_REPO=$(current_repository)
require_registered_repository "$TARGET_REPO"

COMMAND=${1:-}
case "$COMMAND" in
  identity)
    printf '%s <%s> acting on %s\n' \
      "$AGENT_GITHUB_USER" "$AGENT_GITHUB_EMAIL" "$TARGET_REPO"
    ;;
  commit)
    shift
    for argument in "$@"; do
      case "$argument" in
        --author|--author=*)
          printf 'agent-git: --author overrides are disabled\n' >&2
          exit 1
          ;;
      esac
    done
    exec env \
      GIT_AUTHOR_NAME="$AGENT_GITHUB_USER" \
      GIT_AUTHOR_EMAIL="$AGENT_GITHUB_EMAIL" \
      GIT_COMMITTER_NAME="$AGENT_GITHUB_USER" \
      GIT_COMMITTER_EMAIL="$AGENT_GITHUB_EMAIL" \
      git \
        -c user.name="$AGENT_GITHUB_USER" \
        -c user.email="$AGENT_GITHUB_EMAIL" \
        -c gpg.format=ssh \
        -c user.signingkey="$AGENT_GITHUB_SIGNING_KEY" \
        -c commit.gpgsign=true \
        commit "$@"
    ;;
  push)
    shift
    exec env \
      GIT_SSH_COMMAND="ssh -i $AGENT_GITHUB_AUTH_KEY -o IdentitiesOnly=yes -o StrictHostKeyChecking=accept-new" \
      git push "git@github.com:$TARGET_REPO.git" "$@"
    ;;
  *)
    printf 'Usage: agent-git {identity|commit|push} ...\n' >&2
    printf 'Use ordinary git for read-only and staging operations.\n' >&2
    exit 2
    ;;
esac
